# Copy to .env and fill in. Never commit .env.
FIREWORKS_API_KEY=

# Bedrock (Claude + OpenAI baselines) uses your normal AWS credentials (aws login / aws configure).
# Optionally pick a named profile:
# AWS_PROFILE=

# Only needed if you add the optional direct-OpenAI provider in configs/systems.yaml
# OPENAI_API_KEY=

# Fireworks account id (used by yks.ladder / deploy_sft for dedicated deployments)
# FIREWORKS_ACCOUNT_ID=
